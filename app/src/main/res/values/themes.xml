<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose 版只保留窗口级主题：颜色/排版全部由 ui/AfaTheme.kt 的 Material3 提供。
      不再依赖 Theme.Material3.DayNight（Material Components XML 主题）。
      系统栏由 MainActivity 的 enableEdgeToEdge() 处理，Scaffold 负责 insets。
    -->
    <style name="Theme.AntProxy" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
